DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallback model IDs
OPENROUTER_FALLBACK_MODELS=
# Session-capable URL for LISTEN; use Supabase direct or Session pooler port 5432
DATABASE_LISTEN_URL=
PORT=8787
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SMOKE_BASE_URL=

# Supabase: use the Session pooler (5432), never the project HTTPS API URL.
DATABASE_POOL_MAX=5
# Optional trusted database root certificate PEM, with literal \n between lines.
DATABASE_SSL_CA=
